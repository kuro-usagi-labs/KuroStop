{
  "expo": {
    "name": "KuroStop",
    "slug": "kurostop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kurostop",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.kurostop.personal",
      "supportsTablet": false,
      "buildNumber": "2",
      "infoPlist": {
        "NSFaceIDUsageDescription": "KuroStop memerlukan izin Face ID untuk mengamankan catatan disiplin pribadi Anda.",
        "UIRequiresFullScreen": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F3F0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "KuroStop memerlukan izin Face ID untuk mengamankan catatan disiplin pribadi Anda."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#1C1C1E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
